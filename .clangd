---

CompileFlags:
  Add:
    - "-Wall"
    - "-Wextra"
    - "-Wno-nullability-extension"
    - "-Wno-gnu"
    - "-xc"
    - "-std=gnu23"
    - "-D_GNU_SOURCE"
    - "-D_POSIX_C_SOURCE=200908L"
    # Warn on reserved identifiers
    - "-Wreserved-identifier"
    - "-Wreserved-macro-identifier"
    # include the repo-level include dir
    - "-I./include"
  Compiler: clang

---

If:
  PathMatch: .*\.h
CompileFlags:
  Remove:
    - "-xc"
  Add:
    - "-xc-header"

